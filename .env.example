# ---------------------------------------------------------------------------
# CreaNew — backend (NestJS)
# Copier ce fichier en `.env` puis adapter les valeurs.
# NE JAMAIS committer `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api

# Documentation Swagger
SWAGGER_ENABLED=true
SWAGGER_USER=
SWAGGER_PASSWORD=

# ---------------------------------------------------------------------------
# OAuth social (optionnel — laissez vide pour désactiver)
# ---------------------------------------------------------------------------
OAUTH_GOOGLE_ENABLED=false
OAUTH_FACEBOOK_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# En proxy de même origine, APP_URL doit désigner le frontend accessible au navigateur.
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Premier administrateur : renseigner les trois valeurs exclusivement dans un environnement
# protégé. Création une seule fois après les migrations ; retirer le mot de passe après succès.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
# Facultatifs ; à défaut, le nom d’utilisateur sert de nom d’affichage.
INITIAL_ADMIN_FIRST_NAME=
INITIAL_ADMIN_LAST_NAME=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Remplacer les éléments ci-dessous par les identifiants PostgreSQL réels.
# Encoder les caractères spéciaux du nom d'utilisateur et du mot de passe dans l'URL.
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/creanew
DATABASE_SSL=false
DATABASE_LOGGING=false
# DANGEREUX en production : uniquement en développement
DATABASE_SYNCHRONIZE=false

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_TTL=30d
# Nombre de jours pendant lesquels un refresh token révoqué reste traçable
JWT_REFRESH_COOKIE_NAME=creanew_rt

# ---------------------------------------------------------------------------
# Sécurité
# ---------------------------------------------------------------------------
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Limitation globale, par adresse IP (fenêtre en secondes).
# 300 req/min : un SPA déclenche 4 à 6 requêtes par page affichée, une limite
# trop basse (30) coupait la navigation des utilisateurs légitimes en 429.
# Les routes sensibles gardent leur propre limite, bien plus stricte
# (connexion 10/min, inscription 5/min, mot de passe oublié 3/5 min…).
THROTTLE_TTL=60
THROTTLE_LIMIT=300

# Verrouillage de compte : complète la limitation par IP en protégeant le mot
# de passe lui-même. Au-delà de LOGIN_MAX_ATTEMPTS échecs pour un même compte,
# la connexion est refusée pendant LOGIN_LOCK_TTL secondes, quelle que soit
# l'adresse IP d'origine (utile contre les attaques réparties).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_TTL=900

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ---------------------------------------------------------------------------
# Redis / BullMQ
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_ENABLED=false
QUEUE_PREFIX=creanew

# ---------------------------------------------------------------------------
# MinIO (stockage objet S3)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=mg-central-1
MINIO_PUBLIC_URL=http://localhost:9000
# Bucket unique utilisé pour tous les fichiers (créé automatiquement si absent).
# Les types sont séparés par des préfixes : products/, avatars/,
# seller-documents/ et payment-proofs/.
MINIO_BUCKET=mobilier-shop

# Limites d'upload
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_MAX_FILES=10

# ---------------------------------------------------------------------------
# SMTP
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Adresse de test seulement ; fournir un expéditeur réel vérifié par le fournisseur SMTP.
MAIL_FROM="CreaNew <no-reply@example.org>"
MAIL_ENABLED=false

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=CreaNew
# Devise (MGA = Ariary malgache). Les montants sont des entiers.
DEFAULT_CURRENCY=MGA
# Seuil de stock faible par défaut
DEFAULT_LOW_STOCK_THRESHOLD=5
# Frais de livraison (MGA)
SHIPPING_STANDARD_COST=10000
SHIPPING_EXPRESS_COST=25000
FREE_SHIPPING_THRESHOLD=1500000

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
LOG_LEVEL=debug
