# ---------------------------------------------------------------------------
# MOBILIER-SHOP — backend (NestJS)
# Copier ce fichier en `.env` puis adapter les valeurs.
# NE JAMAIS committer `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api

# Documentation Swagger
SWAGGER_ENABLED=true
SWAGGER_USER=
SWAGGER_PASSWORD=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mobilier_shop
DATABASE_USER=mobilier
DATABASE_PASSWORD=mobilier
DATABASE_SSL=false
DATABASE_LOGGING=false
# DANGEREUX en production : uniquement en développement
DATABASE_SYNCHRONIZE=false

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_TTL=30d
# Nombre de jours pendant lesquels un refresh token révoqué reste traçable
JWT_REFRESH_COOKIE_NAME=mobilier_rt

# ---------------------------------------------------------------------------
# Sécurité
# ---------------------------------------------------------------------------
BCRYPT_ROUNDS=12
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Limitation globale, par adresse IP (fenêtre en secondes).
# 300 req/min : un SPA déclenche 4 à 6 requêtes par page affichée, une limite
# trop basse (30) coupait la navigation des utilisateurs légitimes en 429.
# Les routes sensibles gardent leur propre limite, bien plus stricte
# (connexion 5/min, inscription 10/min, mot de passe oublié 3/5 min…).
THROTTLE_TTL=60
THROTTLE_LIMIT=300

# Verrouillage de compte : complète la limitation par IP en protégeant le mot
# de passe lui-même. Au-delà de LOGIN_MAX_ATTEMPTS échecs pour un même compte,
# la connexion est refusée pendant LOGIN_LOCK_TTL secondes, quelle que soit
# l'adresse IP d'origine (utile contre les attaques réparties).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_TTL=900

CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---------------------------------------------------------------------------
# Redis / BullMQ
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_ENABLED=false
QUEUE_PREFIX=mobilier

# ---------------------------------------------------------------------------
# MinIO (stockage objet S3)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=mobilier
MINIO_SECRET_KEY=mobilier_secret
MINIO_REGION=mg-central-1
MINIO_PUBLIC_URL=http://localhost:9000
# Buckets créés automatiquement au démarrage si absents
MINIO_BUCKET_PRODUCTS=products
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_SELLER_DOCUMENTS=seller-documents
MINIO_BUCKET_PAYMENT_PROOFS=payment-proofs

# Limites d'upload
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_MAX_FILES=10

# ---------------------------------------------------------------------------
# SMTP
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="MOBILIER-SHOP <no-reply@mobilier-shop.local>"
MAIL_ENABLED=false

# ---------------------------------------------------------------------------
# Application / URLs
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
APP_NAME=MOBILIER-SHOP
# Devise (MGA = Ariary malgache). Les montants sont des entiers.
DEFAULT_CURRENCY=MGA
# Seuil de stock faible par défaut
DEFAULT_LOW_STOCK_THRESHOLD=5
# Frais de livraison (MGA)
SHIPPING_STANDARD_COST=10000
SHIPPING_EXPRESS_COST=25000
FREE_SHIPPING_THRESHOLD=1500000

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
LOG_LEVEL=debug
